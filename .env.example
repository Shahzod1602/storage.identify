# Control-plane (platform) Postgres ulanishi.
# Superuser kerak: provisioner CREATE DATABASE / CREATE ROLE bajaradi.
DATABASE_URL=postgres://shahzod@localhost:5432/platform

# Loyiha database'lari yaratiladigan klaster (odatda control-plane bilan bir xil).
# Provisioner shu ulanishdan foydalanib `proj_<ref>` database yaratadi.
PROJECTS_DATABASE_URL=postgres://shahzod@localhost:5432/postgres

# Muhit: development | production | test
# production'da default secretlar RAD etiladi (`./scripts/gen-secrets.sh` ishlating).
NODE_ENV=development

# Gateway
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

# CORS: vergul bilan ajratilgan domenlar. "*" = hammasi (faqat dev!).
# Masalan: https://app.misol.uz,https://admin.misol.uz
GATEWAY_CORS_ORIGINS=*

# SQL statement timeout (ms) — og'ir/osilib qolgan so'rovlarni to'xtatadi
STATEMENT_TIMEOUT_MS=15000

# Platform-darajadagi maxfiy kalit (loyiha jwt_secret'larini SHIFRLASH va
# authenticator parollarini hosil qilish uchun). PRODUCTIONда ALBATTA o'zgartiring!
# Generatsiya: openssl rand -hex 32   (BIR MARTA o'rnating — keyin o'zgartirmang!)
PLATFORM_SECRET=dev-only-change-me-please-32bytes-min

# Storage fayllari saqlanadigan katalog
STORAGE_DIR=./storage-data

# ── Email / SMTP (Auth: tasdiqlash + parol tiklash) ──
# SMTP_HOST bo'sh bo'lsa email yuborilmaydi (dev'da konsolga loglanadi).
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
# SMTP_SECURE=false
# SMTP_FROM=storagedb <no-reply@misol.uz>
# true: signup avtomatik tasdiqlanadi. false: email tasdiqlash talab qilinadi.
AUTH_AUTOCONFIRM=true

# Dashboard admin endpointlari uchun token. PRODUCTIONда o'zgartiring!
PLATFORM_ADMIN_TOKEN=dev-admin-token-change-me

# Log darajasi
LOG_LEVEL=info
